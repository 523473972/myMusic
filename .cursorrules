## 核心模块使用指南

### 音乐播放 (TrackPlayer)

```typescript
import TrackPlayer, {
    useCurrentMusic,
    usePlayList,
    useMusicState
} from "@/core/trackPlayer";

// 播放音乐
await TrackPlayer.play(musicItem);

// 暂停
await TrackPlayer.pause();

// 上一首/下一首
await TrackPlayer.skipToPrevious();
await TrackPlayer.skipToNext();

// 添加到播放列表
TrackPlayer.add(musicItem);
TrackPlayer.addNext(musicItem); // 添加到下一首

// 在组件中使用 hooks
const currentMusic = useCurrentMusic();
const playList = usePlayList();
const musicState = useMusicState();
```

### 插件管理 (PluginManager)

```typescript
import PluginManager, { usePlugins } from "@/core/pluginManager";

// 安装插件
await PluginManager.installPluginFromUrl(url);
await PluginManager.installPluginFromLocalFile(path);

// 获取插件
const plugin = PluginManager.getByMedia(musicItem);
const plugin = PluginManager.getByName("pluginName");

// 使用插件方法
const source = await plugin?.methods.getMediaSource(musicItem, "standard");
const searchResult = await plugin?.methods.search(keyword, 1, "music");

// 获取可搜索的插件
const plugins = PluginManager.getSearchablePlugins("music");
```

### 配置管理 (AppConfig)

```typescript
import Config, { useAppConfig } from "@/core/appConfig";

// 获取配置
const maxCacheSize = Config.getConfig("basic.maxCacheSize");

// 设置配置
Config.setConfig("basic.autoPlayWhenAppStart", true);

// 在组件中使用 hook
const autoPlay = useAppConfig("basic.autoPlayWhenAppStart");
```

### 对话框与面板

```typescript
// 对话框
import { showDialog, hideDialog } from "@/components/dialogs/useDialog";

showDialog("SimpleDialog", {
    title: "提示",
    content: "这是一条消息",
});

// 面板
import { showPanel, hidePanel } from "@/components/panels/usePanel";

showPanel("PlayList"); // 显示播放列表面板
```

### Toast 提示

```typescript
import Toast from "@/utils/toast";

Toast.success("操作成功");
Toast.warn("警告信息");
```

